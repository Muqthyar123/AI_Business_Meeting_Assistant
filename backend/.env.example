# ==============================================================================
# AI Business Meeting Assistant - Backend Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env  (or Copy-Item .env.example .env in PowerShell)
# 2. Adjust values below for your local environment or MongoDB Atlas setup.
# 3. Never commit .env to version control.
# ==============================================================================

# Application Environment (development, production, testing)
APP_ENV=development
DEBUG=true

# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=meeting_assistant

# File Upload Settings
# Directory where recorded audio and document files are temporarily stored
UPLOAD_DIR=uploads
# Maximum allowed upload size in megabytes
MAX_UPLOAD_SIZE_MB=100

# OpenAI Whisper Configuration
# Available model sizes: tiny, base, small, medium, large
# 'small' is recommended as a balance between speed and transcription accuracy
WHISPER_MODEL=small

# LLM Provider Configuration (Groq Cloud)
# Get an API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
# Recommended Groq models: llama-3.3-70b-versatile, llama-3.1-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=qwen/qwen3.8-27b
LLM_PROVIDER=groq
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60.0

# CORS Allowed Origins (comma-separated list for multiple origins)
# Default React development server is http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
